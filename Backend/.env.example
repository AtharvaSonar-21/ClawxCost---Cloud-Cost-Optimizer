# Clawxcost Environment Configuration
# Copy this file to .env and update with your values

# MongoDB Connection
# Local development (default)
MONGO_URI=mongodb://localhost:27017/clawxcost

# Cloud MongoDB (Atlas example)
# MONGO_URI=mongodb+srv://username:password@cluster.mongodb.net/clawxcost?retryWrites=true&w=majority

# Server Configuration
PORT=5000
NODE_ENV=development
CORS_ORIGIN=http://localhost:3000

# Auth Configuration
JWT_SECRET=replace-with-strong-secret
JWT_EXPIRY=24h
GOOGLE_CLIENT_ID=

# Comma separated list of emails allowed to register/login as admin role
ADMIN_EMAILS=

# AI Configuration (optional: can also be configured via /admin/config/gemini-key)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-1.5-flash

# Optional: Cloud Provider Credentials (for real API integration - Hour 13+)
# AWS
# AWS_ACCESS_KEY_ID=your_aws_key
# AWS_SECRET_ACCESS_KEY=your_aws_secret
# AWS_REGION=us-east-1

# GCP
# GCP_PROJECT_ID=your_gcp_project
# GCP_CREDENTIALS_PATH=./credentials.json

# Azure
# AZURE_SUBSCRIPTION_ID=your_subscription_id
# AZURE_TENANT_ID=your_tenant_id
# AZURE_CLIENT_ID=your_client_id
# AZURE_CLIENT_SECRET=your_client_secret
